import csv
import os
import requests

# --- CONFIGURATION ---
API_KEY = os.getenv("LEGISCAN_API_KEY")
STATE = "nc"  # North Carolina
OUTPUT_FILE = "lake_james_legislation.csv"

# Keywords stored in lowercase for reliable matching
KEYWORDS = [
    "water quality",
    "discharge permit",
    "sedimentation",
    "siltation",
    "riparian buffer",
    "wetlands",
    "isolated wetlands",
    "interbasin transfer",
    "stormwater",
    "pfas",
    "lake james",
    "data centers",
]


def fetch_bill_list(api_key, state):
    """Fetches a list of all bills for the current session in the specified state."""
    url = f"https://api.legiscan.com/?key={api_key}&op=getMasterList&state={state}"
    response = requests.get(url)
    if response.status_code == 200:
        data = response.json()
        if data.get("status") == "OK":
            master_list = data.get("masterlist", {})
            return [val for key, val in master_list.items() if key != "session"]
    print("Error fetching master list from LegiScan.")
    return []


def fetch_bill_details(api_key, bill_id):
    """Fetches detailed summary and history for a specific bill."""
    url = f"https://api.legiscan.com/?key={api_key}&op=getBill&id={bill_id}"
    response = requests.get(url)
    if response.status_code == 200:
        data = response.json()
        if data.get("status") == "OK":
            return data.get("bill", {})
    return {}


def main():
    if not API_KEY:
        print("Error: LEGISCAN_API_KEY environment variable is missing.")
        return

    print(f"Starting scan for {STATE.upper()} legislation impacting Lake James...")
    all_bills = fetch_bill_list(API_KEY, STATE)
    print(f"Found {len(all_bills)} total bills in current session.")

    matches = []

    for b in all_bills:
        title_desc = (b.get("title", "") + " " + b.get("description", "")).lower()

        matched = False
        trigger_keyword = ""

        for kw in KEYWORDS:
            if kw in title_desc:
                matched = True
                trigger_keyword = kw
                break

        if matched:
            bill_id = b.get("bill_id")
            bill_number = b.get("number", "Unknown")
            print(f"Match found: {bill_number} - {b.get('title', '')[:50]}...")

            details = fetch_bill_details(API_KEY, bill_id) if bill_id else {}

            sponsors = ", ".join(
                [s.get("name", "") for s in details.get("sponsors", [])]
            )

            matches.append(
                {
                    "Bill_ID": bill_number,
                    "Title": b.get("title"),
                    "Current_Status": b.get("status_desc"),
                    "Last_Action_Date": b.get("last_action_date"),
                    "Trigger_Keyword": trigger_keyword,
                    "Sponsors": sponsors,
                    "Source_URL": b.get("url"),
                }
            )

    # Always write CSV headers so the file exists even when no matches are found
    fieldnames = [
        "Bill_ID",
        "Title",
        "Current_Status",
        "Last_Action_Date",
        "Trigger_Keyword",
        "Sponsors",
        "Source_URL",
    ]

    with open(OUTPUT_FILE, mode="w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        if matches:
            writer.writerows(matches)

    print(f"Scan complete. {len(matches)} relevant bills saved to {OUTPUT_FILE}")


if __name__ == "__main__":
    main()
